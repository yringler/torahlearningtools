     {
      "he": "הָרִאשׁוֹנִים",
      "en": "the early ones"
     },
     {
      "he": "הָיוּ",
      "en": "would"
     },
     {
      "he": "שׁוֹהִים",
      "en": "wait"
     }
    ]
   },
   {
    "he": "שָׁעָה אַחַת וּמִתְפַּלְּלִים,",
    "en": "one hour and then daven,",
    "words": [
     {
      "he": "שָׁעָה",
      "en": "an hour"
     },
     {
      "he": "אַחַת",
      "en": "one"
     },
     {
      "he": "וּמִתְפַּלְּלִים,",
      "en": "and then daven"
     }
    ]
   },
   {
    "he": "כְּדֵי שֶׁיְּכַוְּנוּ אֶת לִבָּם לַמָּקוֹם.",
    "en": "so they could turn their hearts to Hashem.",
    "words": [
     {
      "he": "כְּדֵי",
      "en": "so that"
     },
     {
      "he": "שֶׁיְּכַוְּנוּ",
      "en": "they would direct"
     },
     {
      "he": "אֶת",
      "en": "(the)"
     },
     {
      "he": "לִבָּם",
      "en": "their heart"
     },
     {
      "he": "לַמָּקוֹם.",
      "en": "to Hashem",
      "note": "\"HaMakom\" is a name for Hashem, Who is everywhere."
     }
    ]
   },
   {
    "he": "אֲפִלּוּ הַמֶּלֶךְ שׁוֹאֵל בִּשְׁלוֹמוֹ,",
    "en": "Even if the king says hello to him,",
    "words": [
     {
      "he": "אֲפִלּוּ",
      "en": "even"
     },
     {
      "he": "הַמֶּלֶךְ",
      "en": "the king"
     },
     {
