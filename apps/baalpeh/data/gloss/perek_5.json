      "he": "מִתּוֹךְ",
      "en": "from within"
     },
     {
      "he": "כֹּבֶד",
      "en": "heaviness of"
     },
     {
      "he": "רֹאשׁ.",
      "en": "head"
     }
    ]
   },
   {
