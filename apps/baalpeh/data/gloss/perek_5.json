[
 {
  "perek": 5,
  "mishnah": 1,
  "summary": "How to get ready for davening: think seriously first, and once you start, don't stop for anything.",
  "chunks": [
   {
    "he": "אֵין עוֹמְדִין לְהִתְפַּלֵּל אֶלָּא",
    "en": "We only stand up to daven",
    "words": [
     {
      "he": "אֵין",
      "en": "we do not"
     },
     {
      "he": "עוֹמְדִין",
      "en": "stand"
     },
     {
      "he": "לְהִתְפַּלֵּל",
      "en": "to daven"
     },
     {
      "he": "אֶלָּא",
      "en": "except"
     }
    ]
   },
   {
    "he": "מִתּוֹךְ כֹּבֶד רֹאשׁ.",
    "en": "with a serious, humble feeling.",
