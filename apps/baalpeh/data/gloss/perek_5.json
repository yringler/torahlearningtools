      "he": "בְּרָכָה",
      "en": "a bracha"
     },
     {
      "he": "רְבִיעִית",
      "en": "fourth"
     },
     {
      "he": "בִּפְנֵי",
      "en": "by"
     },
     {
      "he": "עַצְמָהּ.",
